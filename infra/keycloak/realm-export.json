{
  "realm": "shop",
  "enabled": true,
  "displayName": "Liva",
  "loginTheme": "liva",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "defaultRoles": [
    "buyer"
  ],
  "roles": {
    "realm": [
      {
        "name": "buyer",
        "description": "Standard storefront customer"
      },
      {
        "name": "seller",
        "description": "Granted only after an approved seller application"
      },
      {
        "name": "admin",
        "description": "Platform administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "shop-web",
      "name": "Liva Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:5174",
        "http://127.0.0.1:5174"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "shop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "shop-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shop-api-admin",
      "name": "Liva API seller role provisioner",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-secret"
    }
  ]
}
