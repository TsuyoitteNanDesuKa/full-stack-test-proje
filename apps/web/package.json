{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:smoke": "vitest run -t @smoke",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/run-playwright.mjs",
    "test:e2e:smoke": "node e2e/run-playwright.mjs --grep @smoke",
    "test:e2e:keycloak": "node e2e/run-playwright.mjs --grep @keycloak",
    "contract:generate": "node scripts/openapi-contract.mjs",
    "contract:check": "node scripts/openapi-contract.mjs --check && tsc -p tsconfig.contract.json",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "oidc-client-ts": "^3.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript-codegen": "^0.31.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
